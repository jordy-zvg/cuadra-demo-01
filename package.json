{
  "name": "cuadra",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "coverage": "pnpm -r coverage",
    "start:api": "pnpm --filter @cuadra/api start",
    "start:executor": "pnpm --filter @cuadra/executor start:poll",
    "pey:check": "pnpm --filter @cuadra/api pey:check"
  }
}
