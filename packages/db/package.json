  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./testing": "./src/testing.ts"
