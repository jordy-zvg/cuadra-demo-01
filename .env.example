# Copia a .env (nunca se commitea). Sin secretos reales aquí.
DATABASE_URL=postgres://cuadra:cuadra@localhost:5432/cuadra
REDIS_URL=redis://localhost:6379
TZ=America/Mexico_City

# Passkeys (WebAuthn)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# Solo apps/executor lee estas variables.
PAYMENTS_PROVIDER=mock
MOCK_WEBHOOK_SECRET=

# Fintoc (PAYMENTS_PROVIDER=fintoc). Solo apps/executor. Usa llaves sk_test_ en el hackathon.
FINTOC_SECRET_KEY=
FINTOC_ACCOUNT_ID=
# Llave privada PEM (RS256) cuya pública se subió al dashboard de Fintoc (JWS Public Keys).
FINTOC_JWS_PRIVATE_KEY=
# Secreto del webhook endpoint; lo usa apps/api para validar Fintoc-Signature.
FINTOC_WEBHOOK_SECRET=

# pey (cobros CoDi). Sin PEY_API_KEY la app corre en modo CoDi simulado.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# Celular (10 dígitos o +52...) con CoDi de la clienta de demo "Doña Lupe".
DEMO_CUSTOMER_PHONE=
PUBLIC_URL=
# Intérprete con Claude (tres extracciones con consenso). Sin llave: reglas.
ANTHROPIC_API_KEY=
PEY_BANK_ACCOUNT_ID=
# Valor de la UDI (Banxico, serie SP68257) para el monitor de tope Nivel 2 Bis.
UDI_VALOR=

# WhatsApp Cloud API (Meta). Se activa solo con las cuatro variables; si falta una, queda el chat web.
# Webhook en Meta: <PUBLIC_URL>/webhooks/whatsapp, campo "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Opcional; por defecto v27.0.
WHATSAPP_GRAPH_VERSION=
# Celular del comercio de demo: el único número que puede darle instrucciones al agente por WhatsApp.
DEMO_MERCHANT_PHONE=
