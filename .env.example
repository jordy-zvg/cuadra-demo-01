# Copia a .env (nunca se commitea). Sin secretos reales aquí.
DATABASE_URL=postgres://cuadra:cuadra@localhost:5432/cuadra
REDIS_URL=redis://localhost:6379
TZ=America/Mexico_City

# Passkeys (WebAuthn)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# Solo apps/executor lee estas variables.
PAYMENTS_PROVIDER=mock
MOCK_WEBHOOK_SECRET=

# Fintoc (PAYMENTS_PROVIDER=fintoc). Solo apps/executor. Usa llaves sk_test_ en el hackathon.
FINTOC_SECRET_KEY=
FINTOC_ACCOUNT_ID=
# Llave privada PEM (RS256) cuya pública se subió al dashboard de Fintoc (JWS Public Keys).
FINTOC_JWS_PRIVATE_KEY=
# Secreto del webhook endpoint; lo usa apps/api para validar Fintoc-Signature.
FINTOC_WEBHOOK_SECRET=

# pey (cobros CoDi). Sin PEY_API_KEY la app corre en modo CoDi simulado.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# Celular (10 dígitos o +52...) con CoDi de la clienta de demo "Doña Lupe".
DEMO_CUSTOMER_PHONE=
PUBLIC_URL=
# Intérprete con Claude (tres extracciones con consenso). Sin llave: reglas.
ANTHROPIC_API_KEY=
PEY_BANK_ACCOUNT_ID=
# Valor de la UDI (Banxico, serie SP68257) para el monitor de tope Nivel 2 Bis.
UDI_VALOR=
# Contraseña de la demo (HTTP Basic). Vacía = app abierta.
DEMO_PASSWORD=
# Celular real (10 dígitos o +52...) del dueño del comercio para WhatsApp/SMS. Sin él no se le envía nada.
DEMO_OWNER_PHONE=

# WhatsApp Cloud API (Meta). Se activa solo con las cuatro variables; si falta una, queda el chat web.
# Webhook en Meta: <PUBLIC_URL>/webhooks/whatsapp, campo "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Solo para dar de alta las plantillas: pnpm --filter @cuadra/api templates:create
WHATSAPP_WABA_ID=
# Opcional; por defecto v25.0.
WHATSAPP_GRAPH_VERSION=
# Notas de voz por WhatsApp (opcional). Llave de un servicio compatible con la API de transcripción de
# OpenAI. Sin ella, a los audios se les contesta que escriban. Para Groq:
# STT_BASE_URL=https://api.groq.com/openai/v1 y STT_MODEL=whisper-large-v3-turbo.
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# Recordatorios programados (hora de CDMX). Días 0=domingo ... 6=sábado; hora de 9 a 19. Sin ellas, apagado.
REMINDER_DAYS=
REMINDER_HOUR=

# Cada cuánto se concilia contra pey (ms). Default 5 min.
PEY_RECONCILE_MS=
# Solo demo: minutos entre recordatorios al mismo cliente (regla P03). Vacío = 72 horas.
REMINDER_MIN_INTERVAL_MINUTES=
# Al confirmar un fiado, avisar al cliente por WhatsApp y mandar la solicitud CoDi. "off" lo apaga.
AUTO_COBRO_FIADO=
# Solo demo: horario de cobros en CDMX ("0-24" = sin límite). Vacío = 9 a 20.
REMINDER_HOURS=
# Solo demo: horario de pagos a proveedor sin passkey (R10) en CDMX ("0-24" = sin límite). Vacío = 7 a 22.
# Va en la API y en el executor con el mismo valor (el executor revalida con su propia copia).
OUTFLOW_HOURS=
